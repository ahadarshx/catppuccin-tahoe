[Icon Theme]
Name=MacTahoe-Apps
Comment=MacTahoe app icons with GNOME Adwaita for everything else
Inherits=Adwaita,hicolor
Directories=apps/16,apps/22,apps/32,apps/scalable

[apps/16]
Size=16
Context=Applications
Type=Fixed

[apps/22]
Size=22
Context=Applications
Type=Fixed

[apps/32]
Size=32
Context=Applications
Type=Fixed

[apps/scalable]
Size=64
Context=Applications
MinSize=16
MaxSize=512
Type=Scalable
